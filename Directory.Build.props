<Project>

    <!-- Project -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);RMG020;NU1900</NoWarn>
    </PropertyGroup>

    <!-- Documentation -->
    <PropertyGroup Condition="$(Configuration) == 'Debug'">
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Analyzer -->
    <PropertyGroup>
        <AnalysisLevel>8.0</AnalysisLevel>
        <AnalysisMode>Recommended</AnalysisMode>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- NuGet audit: a vulnerable (transitive) package version should surface as a warning,
             not fail the build. Needed because Microsoft.OpenApi must stay on 2.x for the
             Microsoft.AspNetCore.OpenApi source generator, so a future 2.x advisory cannot
             always be fixed by upgrading. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
    </PropertyGroup>

    <!-- Assembly Meta -->
    <PropertyGroup>
        <Authors>Alisa</Authors>
        <Company>Alisa Lab</Company>
        <Copyright>Copyright © 2023-2026 Alisa and Contributors.</Copyright>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/AlisaAkiron/Atmos.git</RepositoryUrl>
        <NeutralLanguage>en-US</NeutralLanguage>
    </PropertyGroup>

</Project>
