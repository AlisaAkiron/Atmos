<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AV0029/AV0030 want AddOpenApi()/WithDocumentPerVersion(), but Atmos serves a
         single OpenAPI document named after the service rather than one per API version.
         NoWarn instead of .editorconfig because AV0029 also fires in OpenAPI
         source-generated code, which .editorconfig severities do not cover. -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atmos.Database\Atmos.Database.csproj" />
    <ProjectReference Include="..\Atmos.Templates\Atmos.Templates.csproj" />
    <ProjectReference Include="..\Atmos.Services.Default\Atmos.Services.Default.csproj" />
    <ProjectReference Include="..\Atmos.Services.Media\Atmos.Services.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="AspNet.Security.OAuth.Discord" />
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <PackageReference Include="Fido2" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Force Microsoft.AspNetCore.OpenApi to use patched version -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
