# Copy to appsettings.Development.yaml and fill in real values.
# appsettings.Development.yaml is gitignored - never commit real secrets.

Serilog:
  MinimumLevel:
    Default: Debug

# The API creates the database and applies pending migrations at startup, before it
# accepts requests. EF takes a database-wide lock while migrating, so several instances
# booting at once is safe.
#
# Set AutoMigrate to false to leave the schema to a separate deployment step - the API
# then needs no permission to alter it. There is no migration worker to run instead, so
# apply them with the EF tooling, from the repository root:
#
#     dotnet ef database update \
#       --project src/Atmos.Database --startup-project src/Atmos.Api
#
# Adding a migration uses the same project pair:
#
#     dotnet ef migrations add <Name> \
#       --project src/Atmos.Database --startup-project src/Atmos.Api
#
# Database:
#   AutoMigrate: true

Authentication:
  # The site owner role has no configuration. Sign in once to provision the
  # account, then set user.is_site_owner = true on that row directly in the
  # database; the role claim is issued from it on the account's next sign-in.
  #
  # Origins a completed sign-in may return the browser to. Leave it out when the
  # frontend is proxied onto the API's own origin - return_url is then a local
  # path like "/" and already works. Set it when the frontend has an origin of
  # its own, or sign-in lands on the API host and dead-ends there.
  #
  # Matched on scheme, host and port exactly, so list every origin you use.
  #
  # NOTE: if the frontend is on a different registrable domain rather than a
  # sibling subdomain, this alone is not enough - the session cookie is
  # SameSite=Lax and browsers will not send it on cross-site requests at all, so
  # authenticated calls fail silently after a successful sign-in. That needs
  # SameSite=None (see AtmosIdentity.ConfigureIdentity) and is deliberately not
  # done here.
  #
  # ReturnUrls:
  #   - https://atmos.example.com
  OpenIdConnect:
    - Name: my-idp
      DisplayName: My Identity Provider
      Authority: https://idp.example.com/application/o/atmos-dev/
      ClientId: <client-id>
      ClientSecret: <client-secret>
      MetadataAddress: https://idp.example.com/application/o/atmos-dev/.well-known/openid-configuration
      Scopes:
        - openid
        - profile
        - email
  OAuthProviders:
    - Type: GitHub
      Name: github
      DisplayName: GitHub
      ClientId: <client-id>
      ClientSecret: <client-secret>
  WebAuthn:
    Enable: true
    ServerDomain: localhost
    ServerName: Atmos Dev
    Origins:
      - https://localhost:7136

Email:
  SenderAddress: atmos@localhost
  SenderName: Atmos

# Cors:
#   AllowedOrigins:
#     - https://app.example.com

# Reverse proxy. Leave this off when Kestrel is reached directly, as it is in
# development - X-Forwarded-* are supplied by the caller, and only a proxy that
# overwrites them makes them worth believing.
#
# Turn it on for any deployment that terminates TLS in front of the app. Without
# it the scheme reads as http, which builds an OIDC redirect_uri the provider
# rejects and suppresses every Secure cookie, and the client address reads as the
# proxy's, which collapses per-IP rate limiting onto one partition.
#
# Leaving KnownProxies and KnownNetworks empty trusts any proxy. That is correct
# when nothing can reach the app except through the ingress, and wrong the moment
# the app's own port is reachable - anyone could then claim any address and
# scheme. Set either list to narrow it.
#
# Network:
#   UseForwardedHeaders: true
#   ForwardLimit: 1              # proxy hops to trust; a CDN in front of an ingress is 2
#   KnownProxies:
#     - 10.0.0.5
#   KnownNetworks:
#     - 10.0.0.0/8

# Host header allowlist. X-Forwarded-Host is honoured once the block above is on,
# and it is as forgeable as the rest, so name the public hostnames here rather
# than leaving the "*" default in production.
#
# AllowedHosts: "atmos.example.com;www.atmos.example.com"

# Media storage. When running via the AppHost these are injected as env vars -
# no manual config needed. Fill in only when running the API standalone.
# Media:
#   Provider: Local              # Local | S3
#   PublicBaseUrl: https://localhost:7136/media
#   MaxUploadSizeBytes: 104857600
#   Local:
#     RootPath: ""               # empty => {ContentRootPath}/media-storage
#     RequestPath: /media
#   S3:
#     ServiceUrl: https://<account-id>.r2.cloudflarestorage.com
#     AccessKeyId: <access-key-id>
#     SecretAccessKey: <secret-access-key>
#     Bucket: atmos-resources
#     EnsureBucketOnStartup: false
